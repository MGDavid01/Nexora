# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora
SECRET_KEY=cambia-esta-clave-local-de-al-menos-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# D7 — Cloudinary. Usa CLOUDINARY_URL o el trío. Sin credencial la subida se omite.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

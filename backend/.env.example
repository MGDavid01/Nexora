# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora
SECRET_KEY=cambia-esta-clave-local-de-al-menos-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Enlace base para recuperación de contraseña (frontend de Ariel).
APP_PUBLIC_URL=http://localhost:5173

# D6 / D10 — Google SMTP. Sin USER/PASSWORD el envío o aviso se omite; el acto de negocio sigue.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=
GOOGLE_SMTP_FROM=
RECUPERACION_TOKEN_MINUTOS=60

# D7 — Cloudinary. Usa CLOUDINARY_URL o el trío. Sin credencial la subida se omite.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# D8 — OpenStreetMap. Nominatim exige User-Agent identificable y email de contacto.
# Máximo 1 petición/s (el adaptador lo aplica). Teselas OSM con atribución.
OSM_GEOCODING_ENABLED=true
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_USER_AGENT=Nexora/0.1
OSM_CONTACT_EMAIL=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_ATTRIBUTION=© OpenStreetMap contributors

# N3/N4 — API del aparato y canal de voz RN-019.
# Vacío = mocks locales. No pongas secretos ni DeepSeek aquí.
APARATO_STT_URL=
APARATO_TTS_URL=
APARATO_CLAVE_MAESTRA=
ESP32_ONLINE_SEGUNDOS=90

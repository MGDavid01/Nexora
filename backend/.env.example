# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora
SECRET_KEY=cambia-esta-clave-local-de-al-menos-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Enlace base para recuperación de contraseña (frontend de Ariel).
APP_PUBLIC_URL=http://localhost:5173

# D6 — Google SMTP. Sin USER/PASSWORD el envío se omite; el acto de negocio sigue.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=
GOOGLE_SMTP_FROM=
RECUPERACION_TOKEN_MINUTOS=60

# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+asyncpg://nexora:nexora@localhost:5432/nexora
SECRET_KEY=cambia-esta-clave-local-de-al-menos-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Google para avisos D10 (y correo D6). Sin USER/PASSWORD el aviso se omite.
GOOGLE_SMTP_HOST=smtp.gmail.com
GOOGLE_SMTP_PORT=587
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=
GOOGLE_SMTP_FROM=
